# ============================================================
#  License Keygen Environment Variables
#  复制为 .env（本地）或在 Vercel 控制台逐项配置
# ============================================================

# ---------- 数据库 ----------
# 生产（Vercel）：必须用托管 PostgreSQL（Vercel Postgres / Supabase / Neon）。
# Vercel serverless 文件系统是临时只读的，SQLite 文件会丢数据！
# 建议使用连接池地址（Vercel Postgres 的 URL 以 "-pooler" 结尾）：
# DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
#
# 本地开发：改用 prisma/schema.sqlite.prisma（SQLite）：
#   npx prisma db push --schema prisma/schema.sqlite.prisma
#   npx prisma generate --schema prisma/schema.sqlite.prisma
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
DATABASE_URL_SQLITE=file:./db/custom.db

# ---------- Ed25519 密钥对 ----------
# 用 license-sdk-python/generate_keypair.py 生成，切勿使用公开过的 demo 密钥
# LICENSE_ED25519_PRIVATE_KEY_B64=REPLACE_WITH_YOUR_PRIVATE_KEY
# LICENSE_ED25519_PUBLIC_KEY_B64=REPLACE_WITH_YOUR_PUBLIC_KEY

# ---------- 管理后台密钥（必填，至少 8 个字符）----------
# 保护 /api/keygen/generate、/api/codes、/api/activations、/api/stats、
# /api/codes/[id]/revoke 等管理接口。Web 控制台"设置"页填入同样的值。
# 未配置时管理接口会直接返回 503（fail-closed）。
LICENSE_ADMIN_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET

# ---------- 可选：暴露公钥给设置页显示 ----------
# NEXT_PUBLIC_LICENSE_ED25519_PUBKEY_B64=REPLACE_WITH_YOUR_PUBLIC_KEY
